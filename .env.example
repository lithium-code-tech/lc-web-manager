# Config web do Firebase (projeto skate-go-android). É pública por natureza —
# quem protege os dados são as regras do Firestore/Storage (skatego-rn).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=skate-go-android.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=skate-go-android
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=skate-go-android.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Só no servidor (Vercel → Settings → Environment Variables). JSON inteiro da
# conta de serviço do Firebase, numa linha. NUNCA commitar.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Desenvolvimento com emuladores (opcional): NEXT_PUBLIC_FIREBASE_EMULATORS=1,
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 e FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
